<div class="page">
  <text class="dist">{{ dist }}</text>
  <div class="track">
    <div class="fill" style="width: {{ fill }}px;"></div>
  </div>
  <image class="arrow" src="{{ arrow }}"></image>
  <text class="instr">{{ instr }}</text>
  <div class="pill">
    <text class="eta">{{ eta }}</text>
  </div>
</div>
